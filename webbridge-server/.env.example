# WebBridge Server Configuration

PORT=3000
HOST=0.0.0.0
MAX_CONCURRENT_SESSIONS=3
SESSION_TIMEOUT_MINUTES=15
LOG_LEVEL=info

# Chromium path (leave empty to use Playwright's bundled browser)
CHROMIUM_PATH=

# Credential vault (never commit real credentials)
# Format: PLATFORM_EMAIL=email@example.com
#         PLATFORM_PASSWORD=secret
# Supported platforms: CHATGPT, GEMINI, COPILOT, ELEVENLABS, RUNWAY, MIDJOURNEY, FIREFLY, IDEOGRAM, PERPLEXITY, SUNO, PIKA, KLING
# CHATGPT_EMAIL=
# CHATGPT_PASSWORD=
# GEMINI_EMAIL=
# GEMINI_PASSWORD=
